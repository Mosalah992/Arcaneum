{
  "name": "arcanaeum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler pages dev",
    "db:local": "wrangler d1 migrations apply arcanaeum --local",
    "db:remote": "wrangler d1 migrations apply arcanaeum --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/vt323": "^5.1.0",
    "animejs": "^4.5.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
