{
  "name": "arcanaeum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/build-seed.mjs",
    "db:local": "wrangler d1 migrations apply arcanaeum --local",
    "db:remote": "wrangler d1 migrations apply arcanaeum --remote",
    "deploy": "npm run build && wrangler pages deploy",
    "import": "node scripts/import-library.mjs",
    "db:reset": "node scripts/reset-local-db.mjs && wrangler d1 migrations apply arcanaeum --local"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/vt323": "^5.1.0",
    "animejs": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
